# SEISMORA — environment variables (Stage 1)
# Copy to .env.local for local dev, or pass as -e flags / --env-file in Docker.

# Path to the SQLite database file. Defaults to ./data/seismora.sqlite locally.
# In Docker the image sets DB_PATH=/data/seismora.sqlite (mount a volume at /data).
DB_PATH=./data/seismora.sqlite

# Secret used to sign session cookies. CHANGE THIS in production to a long
# random string (e.g. output of `openssl rand -hex 32`). If unset, the app
# falls back to a dev-only default and logs a warning at startup.
SESSION_SECRET=change-me-to-a-long-random-string
